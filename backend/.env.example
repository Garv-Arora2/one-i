# Copy to backend/.env and fill in. Every value is optional for local use:
# an empty key means that provider is reported as "not configured", never faked.

ENVIRONMENT=development
# Local default is a SQLite file. For PostgreSQL (docker compose up -d):
# DATABASE_URL=postgresql+psycopg://one_i:one_i@localhost:5432/one_i
DATABASE_URL=sqlite+pysqlite:///./one_i.db
CORS_ORIGINS=http://localhost:3000

# Sign-in (Google Identity Services). Same value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. SESSION_SECRET must be a long random string in production.
GOOGLE_CLIENT_ID=
SESSION_SECRET=change-me-to-a-long-random-string
# none = Google sign-in only; turnstile/recaptcha also need CAPTCHA_SECRET_KEY.
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=

# Public reaction
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=one-i/1.0 by u/your-reddit-username

# News inlets (RSS feeds and the Wikipedia current-events inlet need no key)
NEWS_API_KEY=
GDELT_ENABLED=true
CURRENT_EVENTS_DAYS=3

# Market data (Alpha Vantage)
MARKET_API_KEY=
