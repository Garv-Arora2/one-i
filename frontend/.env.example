# Copy to frontend/.env.local.
# Where the Next.js server reaches the FastAPI backend. The browser never calls
# it directly: /api/* on this site is proxied there (see next.config.ts).
API_BASE_URL=http://127.0.0.1:8000
# Google OAuth Web client ID (not a secret). Same value as the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
